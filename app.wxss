/* ===== 设计规范（与 docs/prototype 一致）===== */
page {
  --color-primary: #1e80ff;
  --color-primary-light: #e8f2ff;
  --color-bg: #f7f8fa;
  --color-card: #ffffff;
  --color-text: #1a1a1a;
  --color-text-2: #666666;
  --color-text-3: #999999;
  --color-border: #f0f0f0;
  --radius-lg: 32rpx;
  --radius-md: 20rpx;
  --radius-full: 999rpx;
  --shadow-card: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);

  background: var(--color-bg);
  color: var(--color-text);
  font-family: 'LXGW WenKai', -apple-system, 'PingFang SC', sans-serif;
  font-size: 28rpx;
}

/* ===== 通用卡片 ===== */
.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

/* ===== 文章卡片（左文右图，首页/列表页共用）===== */
.post-card {
  margin: 0 32rpx 24rpx;
  padding: 28rpx 32rpx 24rpx;
  display: flex;
  gap: 28rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.post-card-hover {
  opacity: 0.85;
}
.post-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.post-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  margin-bottom: 12rpx;
}
.pin-chip {
  display: inline-block;
  background: var(--color-primary);
  color: #fff;
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-md);
  margin-right: 12rpx;
  vertical-align: 4rpx;
}
.post-excerpt {
  font-size: 24rpx;
  color: var(--color-text-2);
  line-height: 1.6;
}
.post-cover {
  width: 216rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: #eef1f5;
  animation: img-fade 0.5s ease-out;
}
.post-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
  margin-top: auto;
  padding-top: 20rpx;
  white-space: nowrap;
  overflow: hidden;
}
.post-meta .meta-date {
  flex-shrink: 0;
}
.post-meta .spacer {
  flex: 1;
}
.meta-stat {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}
.cat-chip {
  background: var(--color-primary-light);
  color: var(--color-primary);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-md);
  font-size: 20rpx;
  max-width: 200rpx;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 加载状态 ===== */
.load-status {
  text-align: center;
  padding: 40rpx 0 60rpx;
  color: var(--color-text-3);
  font-size: 24rpx;
}

/* ===== 返回顶部浮动按钮 ===== */
.back-top {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow: 0 8rpx 24rpx rgba(30, 128, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}
.back-top-hover {
  opacity: 0.85;
}

/* ===== 图片渐入动画（配合浅色背景占位，加载完成时平滑出现） ===== */
@keyframes img-fade {
  from { opacity: 0.3; }
  to { opacity: 1; }
}

/* ===== 文本截断 ===== */
.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.text-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ===== 页面状态（加载/错误/空数据/重试，各页面共用，保持文案与交互一致） ===== */
.state-wrap {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.state-text {
  color: var(--color-text-3);
  font-size: 26rpx;
}
.state-btn {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: var(--radius-full);
  padding: 0 48rpx;
  line-height: 72rpx;
}
.state-btn::after {
  border: none;
}

/* ===== 线条图标（内联 SVG，Feather 风格，颜色随类固化） ===== */
.icon {
  display: inline-block;
  flex-shrink: 0;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
