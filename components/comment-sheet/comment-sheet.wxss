.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.sheet-close {
  font-size: 44rpx;
  line-height: 1;
  color: #999;
  padding: 0 8rpx;
}

.sheet-body {
  padding: 8rpx 32rpx 16rpx;
}

.sheet-nickname {
  height: 76rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.sheet-textarea {
  width: auto;
  min-height: 160rpx;
  max-height: 40vh;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.sheet-counter {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.sheet-counter-over {
  color: #e6432d;
}

.sheet-error {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #e6432d;
}

.sheet-opt {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.sheet-checkbox {
  transform: scale(0.7);
  margin-right: -8rpx;
}

.sheet-privacy {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: #666;
}

.sheet-privacy .sheet-opt {
  margin-top: 8rpx;
}

.sheet-privacy-link {
  color: #1e80ff;
  margin-left: 4rpx;
}

.sheet-privacy-tip {
  color: #999;
  font-size: 22rpx;
}

.sheet-submit {
  margin-top: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: #1e80ff;
  color: #fff;
  font-size: 30rpx;
}

.sheet-submitting {
  opacity: 0.7;
}
