<!-- 博客信息卡 -->
<view class="me-card">
  <view class="me-name">{{blogName}}</view>
  <view class="me-desc">{{blogDesc}}</view>
</view>

<!-- 站点统计 -->
<view class="stats-row card">
  <view class="stat">
    <view class="stat-num">{{stats.postCount}}</view>
    <view class="stat-label">文章</view>
  </view>
  <view class="stat">
    <view class="stat-num">{{stats.categoryCount}}</view>
    <view class="stat-label">分类</view>
  </view>
  <view class="stat">
    <view class="stat-num">{{stats.tagCount}}</view>
    <view class="stat-label">标签</view>
  </view>
  <view class="stat">
    <view class="stat-num">{{stats.visitCount}}</view>
    <view class="stat-label">阅读</view>
  </view>
</view>

<!-- 状态信息（归档/友链/关于/设置等功能规划至 v0.3.x，不提供死入口） -->
<view class="menu-list card">
  <view class="menu-item">
    <text class="m-ico" style="background:#eef1f5"><view class="icon i-comment"></view></text>
    <text>评论功能</text>
    <text class="m-extra">{{commentEnabled ? '已开启' : '已关闭'}}</text>
  </view>
</view>

<view class="version">HaloWeApp v{{version}}</view>
