<!-- 博客信息卡 -->
<view class="me-card">
  <view class="me-name">{{blogName}}</view>
  <view class="me-desc">{{blogDesc}}</view>
</view>

<!-- 站点统计 -->
<view class="stats-row card">
  <view class="stat">
    <view class="stat-num">{{stats.postCount}}</view>
    <view class="stat-label">文章</view>
  </view>
  <view class="stat">
    <view class="stat-num">{{stats.categoryCount}}</view>
    <view class="stat-label">分类</view>
  </view>
  <view class="stat">
    <view class="stat-num">{{stats.tagCount}}</view>
    <view class="stat-label">标签</view>
  </view>
  <view class="stat">
    <view class="stat-num">{{stats.visitCount}}</view>
    <view class="stat-label">阅读</view>
  </view>
</view>

<!-- 功能菜单 -->
<view class="menu-list card">
  <view class="menu-item" bindtap="todo">
    <text class="m-ico" style="background:#e8f2ff">🕐</text>
    <text>归档</text>
    <text class="m-arrow">›</text>
  </view>
  <view class="menu-item" bindtap="todo">
    <text class="m-ico" style="background:#fdeee4">🔗</text>
    <text>友情链接</text>
    <text class="m-arrow">›</text>
  </view>
  <view class="menu-item" bindtap="todo">
    <text class="m-ico" style="background:#e6f7ec">📖</text>
    <text>关于博主</text>
    <text class="m-arrow">›</text>
  </view>
</view>

<view class="menu-list card">
  <view class="menu-item" bindtap="todo">
    <text class="m-ico" style="background:#f3eafd">⚙️</text>
    <text>设置</text>
    <text class="m-arrow">›</text>
  </view>
  <view class="menu-item">
    <text class="m-ico" style="background:#eef1f5">💬</text>
    <text>评论功能</text>
    <text class="m-extra">{{commentEnabled ? '已开启' : '已关闭'}}</text>
  </view>
</view>

<view class="version">HaloWeApp v0.1.0</view>
