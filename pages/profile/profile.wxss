/* ===== 博客信息卡 ===== */
.me-card {
  margin: 16rpx 32rpx 28rpx;
  background: linear-gradient(135deg, #1e80ff 0%, #5aa5ff 100%);
  border-radius: var(--radius-lg);
  padding: 44rpx 40rpx;
  color: #fff;
  box-shadow: 0 12rpx 40rpx rgba(30, 128, 255, 0.25);
}
.me-name {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.me-desc {
  font-size: 24rpx;
  opacity: 0.85;
}

/* ===== 统计 ===== */
.stats-row {
  display: flex;
  margin: 0 32rpx 28rpx;
  padding: 32rpx 0;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat + .stat {
  border-left: 1rpx solid var(--color-border);
}
.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}
.stat-label {
  font-size: 22rpx;
  color: var(--color-text-3);
}

/* ===== 菜单 ===== */
.menu-list {
  margin: 0 32rpx 24rpx;
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  font-size: 28rpx;
}
.menu-item + .menu-item {
  border-top: 1rpx solid var(--color-border);
}
.m-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}
.m-arrow {
  margin-left: auto;
  color: var(--color-text-3);
}
.m-extra {
  margin-left: auto;
  color: var(--color-text-3);
  font-size: 24rpx;
}

.version {
  text-align: center;
  color: var(--color-text-3);
  font-size: 22rpx;
  padding: 40rpx 0 60rpx;
}
