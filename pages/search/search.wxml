<!-- 搜索栏 -->
<view class="search-bar">
  <view class="search-input-wrap">
    <view class="icon i-search"></view>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索文章与瞬间…"
      confirm-type="search"
      focus="{{true}}"
      bindinput="onInput"
      bindconfirm="onSearch"
    />
    <view wx:if="{{keyword}}" class="search-clear" bindtap="onClearInput">
      <view class="icon i-x"></view>
    </view>
  </view>
  <view class="search-btn" bindtap="onSearch">搜索</view>
</view>

<!-- 最近搜索 -->
<view wx:if="{{status === 'idle' && history.length}}" class="history-block">
  <view class="history-head">
    <text class="history-title">最近搜索</text>
    <text class="history-clear" bindtap="onClearHistory">清除</text>
  </view>
  <view class="history-list">
    <text
      wx:for="{{history}}"
      wx:key="*this"
      class="history-chip"
      bindtap="onHistoryTap"
      data-keyword="{{item}}"
    >{{item}}</text>
  </view>
</view>

<!-- 搜索中 -->
<view wx:if="{{status === 'searching'}}" class="state-wrap">
  <view class="state-text">搜索中…</view>
</view>

<!-- 搜索失败：错误态 + 重试 -->
<view wx:elif="{{status === 'error'}}" class="state-wrap">
  <view class="icon i-alert"></view>
  <view class="state-text">搜索失败，请检查网络</view>
  <button class="state-btn" bindtap="onSearch">重新加载</button>
</view>

<!-- 无结果 -->
<view wx:elif="{{status === 'empty'}}" class="state-wrap">
  <view class="icon i-inbox"></view>
  <view class="state-text">没有找到「{{searchedKeyword}}」相关的内容</view>
</view>

<!-- 搜索结果 -->
<block wx:if="{{status === 'done'}}">
  <view class="result-meta">共找到 {{total}} 条相关内容{{total > results.length ? '，展示前 ' + results.length + ' 条' : ''}}</view>
  <view
    wx:for="{{results}}"
    wx:key="metadataName"
    class="result-card card"
    bindtap="goDetail"
    data-name="{{item.metadataName}}"
    data-kind="{{item.kind}}"
    hover-class="post-card-hover"
  >
    <view class="result-kind {{item.kind === 'moment' ? 'result-kind-moment' : ''}}">
      {{item.kind === 'moment' ? '瞬间' : '文章'}}
    </view>
    <view class="result-title text-clamp-2">
      <text
        wx:for="{{item.titleSegments}}"
        wx:for-item="seg"
        wx:key="index"
        class="{{seg.highlight ? 'hl' : ''}}"
      >{{seg.text}}</text>
    </view>
    <view class="result-desc text-clamp-2" wx:if="{{item.descSegments.length}}">
      <text
        wx:for="{{item.descSegments}}"
        wx:for-item="seg"
        wx:key="index"
        class="{{seg.highlight ? 'hl' : ''}}"
      >{{seg.text}}</text>
    </view>
    <view class="result-time">更新于 {{item.updateTime}}</view>
  </view>
</block>
