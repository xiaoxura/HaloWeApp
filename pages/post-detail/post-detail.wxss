.loading-wrap {
  padding: 200rpx 0;
  text-align: center;
  color: var(--color-text-3);
  font-size: 26rpx;
}

.detail-scroll {
  height: 100vh;
}

/* ===== 标题与作者 ===== */
.detail-head {
  padding: 16rpx 40rpx 0;
}
.detail-title {
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 24rpx;
}
.author-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.avatar-placeholder {
  background: linear-gradient(135deg, #1e80ff, #6db3ff);
}
.a-name {
  font-size: 26rpx;
  font-weight: 500;
}
.a-meta {
  font-size: 22rpx;
  color: var(--color-text-3);
  margin-top: 4rpx;
}

/* ===== 封面 ===== */
.detail-cover {
  margin: 0 32rpx 28rpx;
  width: calc(100% - 64rpx);
  height: 320rpx;
  border-radius: var(--radius-lg);
}

/* ===== 正文 ===== */
.richtext {
  padding: 0 40rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  word-break: break-word;
}
/* rich-text 内部元素样式（作用于渲染后的 HTML） */
.richtext h1, .richtext h2, .richtext h3, .richtext h4 {
  font-weight: 600;
  color: var(--color-text);
  margin: 36rpx 0 20rpx;
  line-height: 1.4;
}
.richtext h1 { font-size: 36rpx; }
.richtext h2 { font-size: 34rpx; }
.richtext h3 { font-size: 32rpx; }
.richtext h4 { font-size: 30rpx; }
.richtext p { margin-bottom: 24rpx; }
.richtext img {
  max-width: 100%;
  border-radius: var(--radius-md);
  margin: 24rpx 0;
}
.richtext pre {
  background: #282c34;
  color: #abb2bf;
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin: 24rpx 0;
  font-size: 24rpx;
  line-height: 1.7;
  overflow-x: auto;
  white-space: pre;
}
.richtext code {
  font-family: Consolas, monospace;
}
.richtext p code, .richtext li code {
  background: #f5f6f8;
  color: #d63384;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 26rpx;
}
.richtext pre code {
  background: transparent;
  color: inherit;
  padding: 0;
}
.richtext blockquote {
  margin: 24rpx 0;
  padding: 20rpx 28rpx;
  background: #f7f8fa;
  border-left: 6rpx solid #d6dae1;
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
  color: #666;
}
.richtext ul, .richtext ol {
  margin: 0 0 24rpx 4rpx;
  padding-left: 36rpx;
}
.richtext li { margin-bottom: 8rpx; }
.richtext li::marker { color: var(--color-primary); }
.richtext hr {
  border: none;
  border-top: 1rpx solid #e5e7eb;
  margin: 36rpx 0;
}
.richtext table {
  border-collapse: collapse;
  width: 100%;
  font-size: 24rpx;
  margin: 24rpx 0;
}
.richtext th {
  background: #f5f7fa;
  font-weight: 600;
  padding: 16rpx 24rpx;
  text-align: left;
}
.richtext td {
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f1f3;
}
.richtext a { color: var(--color-primary); }

/* ===== 标签 ===== */
.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 40rpx 28rpx;
}
.tag-chip {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
}

/* ===== 评论区 ===== */
.comment-block {
  margin: 0 32rpx 28rpx;
  padding: 32rpx;
}
.comment-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
}
.comment-empty {
  color: var(--color-text-3);
  font-size: 26rpx;
  text-align: center;
  padding: 40rpx 0;
}
.comment-item {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.c-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.c-avatar-placeholder {
  background: linear-gradient(135deg, #ffb56b, #ff8f5c);
}
.c-body { flex: 1; min-width: 0; }
.c-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.c-name { font-size: 24rpx; font-weight: 500; }
.c-time { font-size: 20rpx; color: var(--color-text-3); }
.c-content { font-size: 26rpx; line-height: 1.6; color: #444; }
.c-reply {
  margin: 16rpx 0 0 16rpx;
  padding: 16rpx 20rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  font-size: 24rpx;
  color: #555;
  line-height: 1.55;
}
.c-reply-name { color: var(--color-primary); }

.bottom-spacer { height: 120rpx; }

/* ===== 底部操作栏 ===== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 112rpx;
  background: var(--color-card);
  box-shadow: 0 -4rpx 32rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.input-fake {
  flex: 1;
  height: 68rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg);
  color: var(--color-text-3);
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  font-size: 24rpx;
}
.act {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  font-size: 18rpx;
  color: var(--color-text-2);
}
.act-icon { font-size: 34rpx; }
.act-on { color: var(--color-primary); }
