/* ===== 自定义导航栏 ===== */
.nav-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-left: 16rpx;
  padding-right: 32rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.nav-back-hover {
  background: rgba(0, 0, 0, 0.05);
}
.nav-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.nav-avatar-ph {
  background: linear-gradient(135deg, #1e80ff, #6db3ff);
}
.nav-author {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text);
  max-width: 320rpx;
}

/* ===== 标题与元信息 ===== */
.detail-head {
  padding: 24rpx 40rpx 0;
}
.title-kicker {
  width: 56rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #1e80ff, #6db3ff);
  margin-bottom: 20rpx;
}
.detail-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0.5rpx;
  color: var(--color-text);
  margin-bottom: 20rpx;
}
.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}
.meta-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.meta-date {
  font-size: 22rpx;
  color: var(--color-text-3);
  flex-shrink: 0;
}
.meta-views {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
  flex-shrink: 0;
}

/* ===== 封面 ===== */
.detail-cover {
  margin: 0 32rpx 28rpx;
  width: calc(100% - 64rpx);
  height: 320rpx;
  border-radius: var(--radius-lg);
  background: #eef1f5;
  animation: img-fade 0.5s ease-out;
}

/* ===== 正文（mp-html 容器；正文内部样式由 post-detail.js 的 tagStyle 定义） ===== */
.post-content {
  padding: 0 40rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  word-break: break-word;
}
.content-empty {
  padding: 80rpx 0;
  text-align: center;
  color: var(--color-text-3);
  font-size: 26rpx;
}

/* ===== 标签 ===== */
.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 40rpx 28rpx;
}
.tag-chip {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
}

/* ===== 评论区 ===== */
.comment-block {
  margin: 0 32rpx 28rpx;
  padding: 32rpx;
}
.comment-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
}
.comment-empty {
  color: var(--color-text-3);
  font-size: 26rpx;
  text-align: center;
  padding: 40rpx 0;
}
.comment-item {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.c-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.c-avatar-placeholder {
  background: linear-gradient(135deg, #ffb56b, #ff8f5c);
}
.c-body { flex: 1; min-width: 0; }
.c-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.c-name { font-size: 24rpx; font-weight: 500; }
.c-time { font-size: 20rpx; color: var(--color-text-3); }
.c-content { font-size: 26rpx; line-height: 1.6; color: #444; }
.c-reply {
  margin: 16rpx 0 0 16rpx;
  padding: 16rpx 20rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  font-size: 24rpx;
  color: #555;
  line-height: 1.55;
}
.c-reply-name { color: var(--color-primary); }

.bottom-spacer { height: 120rpx; }

/* ===== 底部操作栏 ===== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 84rpx;
  background: var(--color-card);
  box-shadow: 0 -4rpx 32rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 28rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.input-fake {
  flex: 1;
  height: 56rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg);
  color: var(--color-text-3);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  font-size: 22rpx;
}
.act {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  font-size: 15rpx;
  color: var(--color-text-2);
  transition: transform 0.15s ease;
}
.act-hover {
  transform: scale(0.85);
}
.act-icon {
  width: 30rpx;
  height: 30rpx;
}
.act-on { color: #ef4444; }
/* 点赞成功时心形弹跳 */
.act-on .act-icon {
  animation: heart-pop 0.35s ease;
}
@keyframes heart-pop {
  0% { transform: scale(1); }
  40% { transform: scale(1.35); }
  100% { transform: scale(1); }
}
