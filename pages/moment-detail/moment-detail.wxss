.moment-detail {
  margin: 24rpx 28rpx 0;
  padding: 32rpx 32rpx 0;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: var(--shadow-card);
}

.detail-owner {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.detail-loadfail {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding-bottom: 18rpx;
  color: #999;
  font-size: 22rpx;
}

.detail-retry {
  color: #1e80ff;
}

.owner-avatar {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #eef1f5;
}

.owner-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: linear-gradient(135deg, #ff9f5a, #ff6f61);
  font-size: 24rpx;
}

.owner-copy {
  min-width: 0;
  flex: 1;
}

.owner-name {
  color: #222;
  font-size: 28rpx;
  font-weight: 600;
}

.owner-time {
  margin-top: 5rpx;
  color: #999;
  font-size: 21rpx;
}

.moment-content,
.moment-plain {
  padding-top: 26rpx;
  color: #333;
  font-size: 28rpx;
  line-height: 1.8;
  word-break: break-word;
}

.moment-plain {
  padding-top: 0;
  white-space: pre-wrap;
}

.inline-empty {
  padding: 90rpx 0;
  color: #999;
  font-size: 25rpx;
  text-align: center;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 28rpx 0 8rpx;
}

.tag-chip {
  padding: 7rpx 18rpx;
  border-radius: 999rpx;
  color: #1e80ff;
  background: #e8f2ff;
  font-size: 22rpx;
}

.detail-stats {
  display: flex;
  gap: 28rpx;
  padding: 24rpx 0 8rpx;
  color: #999;
  font-size: 22rpx;
}

.bottom-spacer {
  height: 130rpx;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 48rpx;
  padding: 0 42rpx env(safe-area-inset-bottom);
  background: #fff;
  box-shadow: 0 -4rpx 32rpx rgba(0, 0, 0, 0.05);
}

.act {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #666;
  font-size: 17rpx;
}

.act-icon {
  width: 32rpx;
  height: 32rpx;
}

.act-on {
  color: #ef4444;
}

/* Moment 评论区复用文章评论的纯文本展示约束。 */
.comment-block {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: var(--shadow-card);
}

.comment-title {
  margin-bottom: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.comment-empty,
.comment-loading,
.comment-more,
.comment-loadfail {
  padding: 24rpx 0;
  color: #999;
  font-size: 24rpx;
  text-align: center;
}

.comment-more,
.comment-retry {
  color: #1e80ff;
}

.comment-loadfail {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.comment-item {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.c-avatar {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 50%;
}

.c-avatar-placeholder {
  background: linear-gradient(135deg, #ffb56b, #ff8f5c);
}

.c-body {
  min-width: 0;
  flex: 1;
}

.c-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.c-name {
  font-size: 24rpx;
  font-weight: 500;
}

.c-time {
  color: #999;
  font-size: 20rpx;
}

.c-content {
  color: #444;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-word;
}

.c-reply {
  margin: 16rpx 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  color: #555;
  background: var(--color-bg, #f6f7f9);
  font-size: 24rpx;
  line-height: 1.55;
}

.c-reply-line {
  line-height: 1.6;
}

.c-reply-name {
  color: #1e80ff;
}

.c-reply-quote {
  color: #999;
  font-size: 22rpx;
}

.c-reply-btn,
.c-more-replies {
  display: inline-block;
  margin-top: 10rpx;
  color: #1e80ff;
  font-size: 22rpx;
}

.c-comment-reply-btn {
  margin-top: 16rpx;
}

.input-fake {
  min-width: 0;
  height: 56rpx;
  flex: 1;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #999;
  background: #f6f7f9;
  font-size: 22rpx;
  line-height: 56rpx;
}

.input-fake-off {
  color: #bbb;
}

.state-subtext {
  max-width: 560rpx;
  color: #aaa;
  font-size: 22rpx;
  text-align: center;
}

.state-link {
  margin: 0;
  padding: 10rpx 30rpx;
  border: 0;
  color: #1e80ff;
  background: transparent;
  font-size: 24rpx;
  line-height: 1.5;
}

.state-link::after {
  border: 0;
}
