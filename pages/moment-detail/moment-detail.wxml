<view wx:if="{{status === 'loading'}}" class="state-wrap">
  <view class="state-text">加载瞬间中…</view>
</view>

<view wx:elif="{{status === 'unavailable'}}" class="state-wrap">
  <view class="icon i-alert"></view>
  <view class="state-text">瞬间功能暂不可用</view>
  <view class="state-subtext">可能是功能已关闭或 Moment 插件不可用</view>
  <button class="state-btn" bindtap="retry">重新检测</button>
  <button class="state-link" bindtap="goBack">返回</button>
</view>

<view wx:elif="{{status === 'notfound'}}" class="state-wrap">
  <view class="icon i-file"></view>
  <view class="state-text">该瞬间不存在、已删除或不再公开</view>
  <button class="state-btn" bindtap="retry">重新加载</button>
  <button class="state-link" bindtap="goBack">返回</button>
</view>

<view wx:elif="{{status === 'error'}}" class="state-wrap">
  <view class="icon i-alert"></view>
  <view class="state-text">加载失败，请检查网络</view>
  <button class="state-btn" bindtap="retry">重新加载</button>
  <button class="state-link" bindtap="goBack">返回</button>
</view>

<block wx:else>
  <view class="moment-detail">
    <view wx:if="{{detailLoadError}}" class="detail-loadfail">
      <text>刷新失败，当前显示旧内容</text>
      <text class="detail-retry" bindtap="retry">点击重试</text>
    </view>
    <view class="detail-owner">
      <image
        wx:if="{{moment.owner.avatar}}"
        class="owner-avatar"
        src="{{moment.owner.avatar}}"
        mode="aspectFill"
      />
      <view wx:else class="owner-avatar owner-placeholder">博</view>
      <view class="owner-copy">
        <view class="owner-name">{{moment.owner.displayName || '博主'}}</view>
        <view class="owner-time">{{moment.releaseTime || '刚刚'}}</view>
      </view>
    </view>

    <view wx:if="{{status === 'empty'}}" class="inline-empty">该瞬间暂无可展示的正文或媒体</view>
    <view wx:else class="moment-content">
      <mp-html
        wx:if="{{moment.html}}"
        content="{{moment.html}}"
        tag-style="{{tagStyle}}"
        lazy-load
        preview-img
        scroll-table
        selectable
        copy-link
        loading-img="/images/img-loading.png"
        error-img="/images/img-error.png"
        bindlinktap="handleLinkTap"
      />
      <view wx:elif="{{moment.text}}" class="moment-plain">{{moment.text}}</view>
    </view>

    <moment-media
      id="momentMedia"
      wx:if="{{moment.media.length}}"
      moment-name="{{moment.name}}"
      media="{{moment.media}}"
      bindposttap="goPostDetail"
    />

    <view wx:if="{{moment.tags.length}}" class="detail-tags">
      <text
        wx:for="{{moment.tags}}"
        wx:key="*this"
        class="tag-chip"
        data-tag="{{item}}"
        bindtap="openTag"
      ># {{item}}</text>
    </view>

    <view class="detail-stats">
      <text>{{moment.stats.upvote}} 个赞</text>
      <text>{{moment.stats.approvedComment}} 条评论</text>
    </view>

    <view wx:if="{{commentEnabled}}" class="comment-block card">
      <view class="comment-title">评论 {{commentTotal || ''}}</view>
      <view wx:if="{{commentLoadError && !comments.length}}" class="comment-loadfail">
        <text>评论加载失败</text>
        <text class="comment-retry" bindtap="retryComments">点击重试</text>
      </view>
      <view wx:elif="{{!comments.length && !commentLoading}}" class="comment-empty">还没有评论，来抢沙发～</view>

      <view wx:for="{{comments}}" wx:key="name" class="comment-item">
        <image wx:if="{{item.avatar}}" class="c-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view wx:else class="c-avatar c-avatar-placeholder"></view>
        <view class="c-body">
          <view class="c-head">
            <text class="c-name">{{item.author}}</text>
            <text wx:if="{{item.top}}" class="c-top">置顶</text>
            <text class="c-time">{{item.time}}</text>
          </view>
          <view class="c-content">{{item.content}}</view>
          <view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="name" class="c-reply">
            <view class="c-reply-line">
              <text class="c-reply-name">{{reply.author}}</text>
              <text wx:if="{{reply.quoteAuthor}}" class="c-reply-quote">回复 @{{reply.quoteAuthor}}</text>
              <text>：{{reply.content}}</text>
            </view>
            <view
              wx:if="{{commentReplyEnabled}}"
              class="c-reply-btn"
              data-comment-name="{{item.name}}"
              data-quote-name="{{reply.name}}"
              data-author="{{reply.author}}"
              bindtap="handleReply"
            >回复</view>
          </view>
          <view
            wx:if="{{item.replyHasNext}}"
            class="c-more-replies"
            data-name="{{item.name}}"
            bindtap="fetchReplies"
          >展开更多回复（共 {{item.replyCount}} 条）</view>
          <view
            wx:if="{{commentReplyEnabled}}"
            class="c-reply-btn c-comment-reply-btn"
            data-comment-name="{{item.name}}"
            data-author="{{item.author}}"
            bindtap="handleReply"
          >回复</view>
        </view>
      </view>

      <view wx:if="{{commentLoading}}" class="comment-loading">加载中…</view>
      <view wx:elif="{{commentLoadError && comments.length}}" class="comment-loadfail">
        <text>加载失败</text>
        <text class="comment-retry" bindtap="retryComments">点击重试</text>
      </view>
      <view wx:elif="{{commentHasNext}}" class="comment-more" bindtap="loadMoreComments">加载更多评论</view>
    </view>
    <view class="bottom-spacer"></view>
  </view>

  <view class="action-bar">
    <view class="input-fake {{commentSubmitEnabled ? '' : 'input-fake-off'}}" bindtap="handleComment">
      {{commentSubmitEnabled ? '说点什么…' : '暂未开放评论'}}
    </view>
    <view class="act {{upvoted ? 'act-on' : ''}}" bindtap="handleUpvote" hover-class="act-hover">
      <view class="act-icon icon {{upvoted ? 'i-heart-on' : 'i-heart'}}"></view>
      <text>{{upvoting ? '处理中' : moment.stats.upvote}}</text>
    </view>
    <view class="act" bindtap="handleShare" hover-class="act-hover">
      <view class="act-icon icon i-share"></view>
      <text>分享</text>
    </view>
  </view>
</block>

<comment-sheet
  id="commentSheet"
  visible="{{sheetVisible}}"
  max-length="{{commentMaxLength}}"
  reply-to="{{sheetReplyTo}}"
  privacy-url="{{privacyUrl}}"
  privacy-version="{{privacyVersion}}"
  consent-given="{{consentGiven}}"
  initial-nickname="{{initialNickname}}"
  bind:submit="onSheetSubmit"
  bind:close="onSheetClose"
/>
