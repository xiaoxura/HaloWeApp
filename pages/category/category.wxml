<!-- 分类网格 -->
<view class="cat-grid">
  <view
    wx:for="{{categories}}"
    wx:key="name"
    class="cat-card card"
    bindtap="goCategoryPosts"
    data-name="{{item.name}}"
    data-title="{{item.displayName}}"
    hover-class="cat-card-hover"
  >
    <image wx:if="{{item.cover}}" class="cat-cover" src="{{item.cover}}" mode="aspectFill" />
    <view wx:else class="cat-cover cat-cover-placeholder">🗂</view>
    <view class="cat-name">{{item.displayName}}</view>
    <view class="cat-count">{{item.postCount}} 篇文章</view>
  </view>
</view>

<view wx:if="{{!categories.length}}" class="empty">暂无分类</view>

<!-- 标签云 -->
<view wx:if="{{tags.length}}" class="tag-cloud card">
  <view class="tag-cloud-title">热门标签</view>
  <view class="tags">
    <text
      wx:for="{{tags}}"
      wx:key="name"
      class="tag"
      bindtap="goTagPosts"
      data-name="{{item.name}}"
      data-title="{{item.displayName}}"
    >{{item.displayName}}</text>
  </view>
</view>
