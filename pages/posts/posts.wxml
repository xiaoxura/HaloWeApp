<view class="posts-page">
  <view
    wx:for="{{postList}}"
    wx:key="name"
    class="post-card"
    bindtap="goDetail"
    data-name="{{item.name}}"
    hover-class="post-card-hover"
  >
    <view class="post-info">
      <view class="post-title text-clamp-2">
        <text wx:if="{{item.pinned}}" class="pin-chip">置顶</text>{{item.title}}
      </view>
      <view class="post-excerpt text-clamp-2" wx:if="{{item.excerpt}}">{{item.excerpt}}</view>
      <view class="post-meta">
        <text wx:if="{{item.category}}" class="cat-chip">{{item.category}}</text>
        <text>{{item.publishTime}}</text>
        <text class="spacer"></text>
        <text>{{item.visits}} 阅读</text>
        <text>{{item.comments}} 评论</text>
      </view>
    </view>
    <image
      wx:if="{{item.cover}}"
      class="post-cover"
      src="{{item.cover}}"
      mode="aspectFill"
      lazy-load
    />
  </view>

  <view class="load-status">
    <text wx:if="{{loading}}">加载中…</text>
    <text wx:elif="{{!hasMore && postList.length}}">— 没有更多了 —</text>
    <text wx:elif="{{!postList.length}}">该分类下暂无文章</text>
  </view>
</view>
