/* ===== 搜索胶囊 ===== */
.search-pill {
  margin: 8rpx 32rpx 24rpx;
  height: 76rpx;
  border-radius: var(--radius-full);
  background: var(--color-card);
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx;
  color: var(--color-text-3);
  font-size: 26rpx;
  box-shadow: var(--shadow-card);
}

/* ===== Banner 轮播 ===== */
.banner {
  margin: 0 32rpx 32rpx;
  height: 320rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}
.banner-img {
  width: 100%;
  height: 100%;
  animation: img-fade 0.5s ease-out;
}
.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent);
}
.pin-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
}
.banner-text {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  color: #fff;
}
.banner-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}
.banner-meta {
  font-size: 22rpx;
  opacity: 0.9;
}

/* ===== 区块标题 ===== */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  margin-bottom: 20rpx;
}
.section-head .title {
  font-size: 32rpx;
  font-weight: 600;
}

/* 文章卡片样式见 app.wxss（与列表页共用） */

/* ===== v0.3.0 公告条 ===== */

.announce-bar {
  display: flex;
  align-items: center;
  margin: 0 24rpx 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(30, 128, 255, 0.08);
  border-radius: 12rpx;
}

.announce-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #1e80ff;
  background: rgba(30, 128, 255, 0.12);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 14rpx;
}

.announce-text {
  flex: 1;
  font-size: 24rpx;
  color: #4a5a6a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.announce-close {
  flex-shrink: 0;
  font-size: 36rpx;
  line-height: 1;
  color: #9aa5b1;
  padding: 0 6rpx;
}
