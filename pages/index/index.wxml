<!-- 搜索胶囊 -->
<view class="search-pill" bindtap="goSearch">
  <view class="icon i-search"></view>
  <text class="placeholder">搜索文章与瞬间…</text>
</view>

<!-- 远程公告条（可关闭，关闭状态按版本保存） -->
<view wx:if="{{announcement}}" class="announce-bar">
  <text class="announce-tag">公告</text>
  <text class="announce-text">{{announcement.content}}</text>
  <view class="announce-close" bindtap="dismissAnnouncement">×</view>
</view>

<!-- Banner 轮播：置顶/精选文章封面 -->
<swiper
  wx:if="{{bannerList.length}}"
  class="banner"
  indicator-dots
  indicator-color="rgba(255,255,255,.45)"
  indicator-active-color="#ffffff"
  autoplay
  circular
  interval="4000"
>
  <swiper-item wx:for="{{bannerList}}" wx:key="name" bindtap="goDetail" data-name="{{item.name}}">
    <image class="banner-img" src="{{item.cover}}" mode="aspectFill" lazy-load />
    <view class="banner-mask"></view>
    <view wx:if="{{item.pinned}}" class="pin-tag">置顶</view>
    <view class="banner-text">
      <view class="banner-title text-ellipsis">{{item.title}}</view>
      <view class="banner-meta">{{item.publishTime}} · {{item.visits}} 阅读 · {{item.comments}} 评论</view>
    </view>
  </swiper-item>
</swiper>

<!-- 最新瞬间：可选插件能力失败时整个模块静默隐藏 -->
<view wx:if="{{latestMoments.length}}" class="moments-module">
  <view class="section-head moments-head">
    <view>
      <text class="title">最新瞬间</text>
      <text class="section-subtitle">轻量记录与动态</text>
    </view>
    <text class="section-more" bindtap="goMoments">查看全部</text>
  </view>
  <moment-card
    wx:for="{{latestMoments}}"
    wx:key="name"
    moment="{{item}}"
    compact="{{true}}"
    bind:detail="goMomentDetail"
    bind:tagtap="goMomentTag"
  />
</view>

<!-- 文章列表 -->
<view class="section-head">
  <text class="title">最新文章</text>
</view>

<!-- 首屏加载失败：错误态 + 重试 -->
<view wx:if="{{loadFailed && !postList.length}}" class="state-wrap">
  <view class="icon i-alert"></view>
  <view class="state-text">加载失败，请检查网络</view>
  <button class="state-btn" bindtap="reloadFirstPage">重新加载</button>
</view>

<!-- 首屏加载中 -->
<view wx:elif="{{loading && !postList.length}}" class="state-wrap">
  <view class="state-text">加载中…</view>
</view>

<view
  wx:for="{{postList}}"
  wx:key="name"
  class="post-card card"
  bindtap="goDetail"
  data-name="{{item.name}}"
  hover-class="post-card-hover"
>
  <view class="post-info">
    <view class="post-title text-clamp-2">
      <text wx:if="{{item.pinned}}" class="pin-chip">置顶</text>{{item.title}}
    </view>
    <view class="post-excerpt text-clamp-2" wx:if="{{item.excerpt}}">{{item.excerpt}}</view>
    <view class="post-meta">
      <text wx:if="{{item.category}}" class="cat-chip">{{item.category}}</text>
      <text class="meta-date">{{item.publishTime}}</text>
      <text class="spacer"></text>
      <view class="meta-stat">
        <view class="icon i-eye"></view>
        <text>{{item.visits}}</text>
      </view>
      <view class="meta-stat">
        <view class="icon i-msg"></view>
        <text>{{item.comments}}</text>
      </view>
    </view>
  </view>
  <image
    wx:if="{{item.cover}}"
    class="post-cover"
    src="{{item.cover}}"
    mode="aspectFill"
    lazy-load
  />
</view>

<!-- 加载状态（有列表时展示分页状态） -->
<view class="load-status" wx:if="{{postList.length}}">
  <text wx:if="{{loading}}">加载中…</text>
  <text wx:elif="{{!hasMore}}">— 没有更多了 —</text>
</view>

<!-- 成功但无数据：空状态 -->
<view wx:if="{{!loading && !loadFailed && !postList.length}}" class="state-wrap">
  <view class="icon i-inbox"></view>
  <view class="state-text">暂无文章</view>
</view>

<!-- 返回顶部 -->
<view wx:if="{{showBackTop}}" class="back-top" bindtap="backTop" hover-class="back-top-hover">
  <view class="icon i-top"></view>
</view>
